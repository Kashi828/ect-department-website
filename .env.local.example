# Copy this file to .env.local and edit the values.

# Password for the /admin control room (REQUIRED — do not leave default in production)
ADMIN_PASSWORD=change-me-please

# Optional: connect Sanity CMS. Without these the site runs on content/data.json.
# NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_VERSION=2024-01-01
